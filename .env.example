# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # worker + scripts only, never the browser
SUPABASE_ANON_KEY=                  # debug UI

# Gemini (free tier key from Google AI Studio)
GEMINI_API_KEY=

# Model routing (defaults; verified at startup)
MODEL_PANEL=gemini-3.5-flash-lite
MODEL_DETECT=gemini-3.5-flash-lite
MODEL_QUIZ=gemini-3.5-flash-lite
MODEL_BRANDFIT=gemini-3.5-flash-lite
MODEL_PLAN=gemini-3.8-flash
MODEL_REPORT=gemini-3.8-flash
MODEL_FALLBACK=gemini-3.5-flash-lite
MODEL_EMBED=gemini-embedding-2
EMBED_DIMS=768

# Quotas as one JSON line (model ids contain dashes, which the Supabase CLI .env parser rejects as variable names).
# Set from YOUR AI Studio rate-limit page; these are conservative defaults.
QUOTAS_JSON={"gemini-3.5-flash-lite":{"rpm":10,"rpd":500},"gemini-3.8-flash":{"rpm":5,"rpd":20},"gemini-embedding-2":{"rpm":10,"rpd":1000}}
QUOTA_SAFETY_MARGIN=0.9

# Panel preset: free | strict
PANEL_PRESET=free

# Optional generative edits (the generative_inpaint Edit DSL op), run on Cloudflare Workers AI.
# Off by default. Token needs the Workers AI Read and Edit permissions.
ENABLE_GENERATIVE_EDITS=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Worker
WORKER_POLL_MS=750
WORKER_CONCURRENCY=2
LOG_LEVEL=info
