{
  "name": "no-logo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "worker": "pnpm --filter @nologo/worker start",
    "app": "pnpm -r --parallel --filter ./apps/* dev",
    "app:sim": "pnpm -r --parallel --filter ./apps/* dev:sim"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "deno",
      "version": "latest",
      "onFail": "download"
    }
  }
}
